# OneBlink MCP server — per-environment configuration.
#
# Per the security steering (.kiro/steering/security.md, rule 3), ONLY values
# that change per OneBlink environment belong here. Operational parameters
# (limit, offset, filters, ...) are workflow tool inputs, NOT env vars.
#
# CREDENTIALS ARE NOT ENV VARS. This is an HTTP-only server: the caller supplies
# its OneBlink Developer Key PER SESSION via request headers (see below).
# Nothing here is a credential.

# OneBlink tenant / instance. One of: oneblink | oneblink-us | civicplus
# Defaults to "oneblink" (OneBlink Console, https://console.oneblink.io).
#   oneblink-us -> https://console.us.oneblink.io
#   civicplus   -> https://console.transform.civicplus.com
# ONEBLINK_TENANT=oneblink

# Optional: absolute path or PATH name of the `oneblink` CLI binary, used by the
# deploy workflows. Per-host, non-secret. When unset the runner resolves
# `oneblink` (`oneblink.cmd` on Windows) from PATH.
# ONEBLINK_CLI_BIN=

# ---------------------------------------------------------------------------
# HTTP transport — used by `npm run start` / `npm run start:http`.
#
# CREDENTIALS ARE REQUEST HEADERS, NOT ENV VARS. The caller supplies its own
# OneBlink Developer Key per session:
#   X-OneBlink-Access-Key / X-OneBlink-Secret-Key
# and (optionally, for the deploy workflows) a separate CLI deploy pair:
#   X-OneBlink-CLI-Access-Key / X-OneBlink-CLI-Secret-Key
# The server holds no keys — nothing below is a credential.
#
# bind/port legitimately differ per environment, so they are env vars
# (security rule 3).
# ---------------------------------------------------------------------------

# Loopback only for the PoC. Never 0.0.0.0 locally. A hosted deployment MUST
# terminate TLS in front so the credential headers are never sent in the clear.
HTTP_BIND=127.0.0.1
HTTP_PORT=3000
