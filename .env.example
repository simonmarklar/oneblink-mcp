# OneBlink MCP server — per-environment configuration.
#
# Per the security steering (.kiro/steering/security.md, rule 3), ONLY values
# that change per OneBlink environment belong here. Operational parameters
# (limit, offset, filters, ...) are workflow tool inputs, NOT env vars.

# OneBlink Developer Key — create in your tenant's console under Developer Keys.
# The key's ROLE PERMISSIONS and APP ASSOCIATIONS gate what workflows can do.
# Secret — never commit a real value.
ONEBLINK_ACCESS_KEY=
ONEBLINK_SECRET_KEY=

# OneBlink tenant / instance. One of: oneblink | oneblink-us | civicplus
# Defaults to "oneblink" (OneBlink Console, https://console.oneblink.io).
#   oneblink-us -> https://console.us.oneblink.io
#   civicplus   -> https://console.transform.civicplus.com
# ONEBLINK_TENANT=oneblink

# ---------------------------------------------------------------------------
# HTTP transport (OAuth Resource Server) — used by `npm run start:http`.
# All per-environment (issuer/audience/JWKS/bind differ per env), so env vars
# are correct here (security rule 3). The OneBlink keys themselves are NOT here
# — they live in the gitignored key file (HTTP_KEY_FILE), keyed by tenant.
# ---------------------------------------------------------------------------

# Loopback only for the PoC. Never 0.0.0.0 locally.
HTTP_BIND=127.0.0.1
HTTP_PORT=3000

# Externally-reachable base URL a client uses to reach THIS server (no trailing
# slash). Distinct from HTTP_BIND: in Docker the server binds 0.0.0.0 but is
# reached at 127.0.0.1:3000. Advertised in the RFC 9728 metadata and the
# WWW-Authenticate `resource_metadata` pointer. Defaults to
# http://127.0.0.1:<HTTP_PORT> when unset (never the bind address).
# HTTP_PUBLIC_URL=http://127.0.0.1:3000

# OAuth issuer + JWKS. PoC = local Keycloak realm "oneblink-poc".
HTTP_OAUTH_ISSUER=http://localhost:8080/realms/oneblink-poc
HTTP_OAUTH_JWKS_URI=http://localhost:8080/realms/oneblink-poc/protocol/openid-connect/certs

# Required token audience — a token whose `aud` != this value is rejected (401).
HTTP_OAUTH_AUDIENCE=oneblink-mcp

# Token claim carrying the tenant key (maps to an entry in HTTP_KEY_FILE).
# HTTP_OAUTH_TENANT_CLAIM=tenant

# Gitignored local OneBlink keys file (PoC credential resolver). Prod swaps
# this resolver for AWS Secrets Manager.
# HTTP_KEY_FILE=oneblink-keys.local.json
