{
  "name": "@oneblink/mcp-server",
  "version": "0.1.0",
  "description": "Workflow-focused Model Context Protocol server for the OneBlink Low-code Suite, built on the official @oneblink/sdk.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "oneblink-mcp": "./dist/http.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "gen:types": "tsx scripts/gen-form-element-types.ts",
    "start": "node dist/http.js",
    "start:http": "node dist/http.js",
    "inspect:http": "mcp-inspector --transport http --server-url http://127.0.0.1:3000/mcp",
    "inspect:cli": "mcp-inspector --cli --transport http --server-url http://127.0.0.1:3000/mcp",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@oneblink/sdk": "^13.2.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.10.1",
    "@oneblink/types": "github:oneblink/types",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
